{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wish-pond",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // 배포(wrangler deploy)·미리보기(wrangler dev) 때마다 먼저 three.js 를 public/vendor 로 복사.
  // public/vendor 는 git 에 없어서, 이게 없으면 Cloudflare 의 GitHub 연동 배포에서 화면이 '불러오는 중'에 멈춤
  "build": { "command": "npm run build" },
  // 정적 파일은 public/
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws", "/", "/index.html"]
  },
  // 연못 하나 = Durable Object 하나 (SQLite 저장소 — 무료 요금제에서 사용 가능)
  "durable_objects": {
    "bindings": [{ "name": "POND", "class_name": "PondDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PondDO"] }],
  "vars": {
    // 소원이 이루어지기까지 필요한 먹이 수 (내가 주든 남이 주든)
    "WISH_GOAL": "5"
  },
  "observability": { "enabled": true }
}
